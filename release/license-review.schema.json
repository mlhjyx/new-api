{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mlhjyx:new-api:license-review:v1",
  "title": "New API exact dependency license review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "distribution",
    "reviewed_license_expressions",
    "dependency_resolutions",
    "evidence",
    "unresolved"
  ],
  "properties": {
    "schema_version": { "const": "new-api-license-review/v1" },
    "status": { "enum": ["HOLD", "APPROVED"] },
    "distribution": { "const": "ghcr.io/mlhjyx/new-api OCI image plus public corresponding source" },
    "reviewed_license_expressions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "dependency_resolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolution" }
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "unresolved": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolved" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "previous_version", "resolved_version", "artifact_integrity", "license_expression", "license_file_sha256", "bundle_reachability", "decision", "evidence_uri"],
      "properties": {
        "ecosystem": { "enum": ["Go", "npm"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 191 },
        "previous_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resolved_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact_integrity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "license_expression": { "type": "string", "minLength": 1, "maxLength": 128 },
        "license_file_sha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "bundle_reachability": { "type": "string", "minLength": 1, "maxLength": 256 },
        "decision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence_uri": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_mod_sha256", "go_sum_sha256", "bun_lock_sha256", "electron_lock_sha256", "license_sha256", "upstream_notice_sha256"],
      "properties": {
        "go_mod_sha256": { "$ref": "#/$defs/sha256" },
        "go_sum_sha256": { "$ref": "#/$defs/sha256" },
        "bun_lock_sha256": { "$ref": "#/$defs/sha256" },
        "electron_lock_sha256": { "$ref": "#/$defs/sha256" },
        "license_sha256": { "$ref": "#/$defs/sha256" },
        "upstream_notice_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "integrity", "scope", "reason_code", "distribution_observation"],
      "properties": {
        "ecosystem": { "const": "npm" },
        "name": { "type": "string", "minLength": 1, "maxLength": 191 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/=]+$" },
        "scope": { "const": "build-only-auto-peer" },
        "reason_code": { "const": "PACKAGE_LICENSE_METADATA_MISSING" },
        "distribution_observation": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
